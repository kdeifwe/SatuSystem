# --- обязательные ---
IG_WORKER_SECRET=            # длинная случайная строка, такая же в Next (IG_WORKER_SECRET)
IG_SESSION_ENCRYPTION_KEY=   # Fernet-ключ, см. README (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SUPABASE_URL=                # https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_INBOUND_URL=            # http://<next-service>.railway.internal:3000/api/instagram/inbound или публичный https URL

# --- необязательные ---
PORT=8000
IG_PROXY_URL=                # http://user:pass@host:port (желательно резидентный)
IG_POLL_MIN_SEC=20
IG_POLL_MAX_SEC=40
IG_POLL_PENDING=true         # опрашивать и «запросы на переписку»
IG_BACKFILL_MINUTES=10       # после рестарта отвечать только на сообщения не старше N минут
IG_MAX_SENDS_PER_HOUR=30
IG_LOCALE=ru_RU
IG_TIMEZONE_OFFSET_SEC=18000 # Asia/Almaty (UTC+5)
LOG_LEVEL=INFO
