NEXT_PUBLIC_SUPABASE_URL=https://your-project.ref.supabase.co
# Public anon key for browser authentication. Do not put the service role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only service role key. Never expose this to client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini model configuration
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_PROMPT_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_OUTPUT_DIM=768
EMBEDDINGS_PROVIDER=gemini
ALLOW_OPENAI_FALLBACK=false

PRIMARY_LLM_PROVIDER=gemini
PRIMARY_LLM_MODEL=gemini-2.5-flash
FALLBACK_LLM_PROVIDER=openai
FALLBACK_LLM_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# WhatsApp Cloud API configuration
NEXT_PUBLIC_APP_URL=https://your-domain.com
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
SKIP_WEBHOOK_SIGNATURE_CHECK=false

# Telegram notifications bot (separate from customer-facing Telegram bot)
# Get bot token from @BotFather: /newbot
TELEGRAM_NOTIFICATIONS_BOT_TOKEN=
TELEGRAM_NOTIFICATIONS_BOT_USERNAME=

# Secret for validating Telegram webhook requests. Generate a long random string.
TELEGRAM_WEBHOOK_SECRET=change-me-generate-64-random-chars

# Google Calendar service account (single shared calendar client)
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Google Calendar OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=change-me-generate-64-random-chars
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Instagram scanning via Apify
APIFY_API_TOKEN=
